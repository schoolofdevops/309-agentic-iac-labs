{
  "checks": [
    {
      "id": "section-1-preflight-completes",
      "describe": "the local-first Section 1 preflight completes without blocking learners",
      "run": "bash section-1/scripts/preflight.sh",
      "assert": {"exit": 0},
      "weight": 3
    },
    {
      "id": "section-1-preflight-reports-reference-profile",
      "describe": "the preflight reports the tested reference profile as guidance",
      "run": "bash section-1/scripts/preflight.sh",
      "assert": {"contains": "tested reference profile"},
      "weight": 2
    },
    {
      "id": "section-1-preflight-discovers-coding-agents",
      "describe": "the preflight reports optional coding-agent availability",
      "run": "bash section-1/scripts/preflight.sh",
      "assert": {"contains": "Coding agents and interfaces (optional)"},
      "weight": 2
    },
    {
      "id": "section-1-preflight-is-safe",
      "describe": "the preflight source has no workload start or infrastructure apply command",
      "run": "node --test section-1/tests/preflight.test.mjs",
      "assert": {"exit": 0},
      "weight": 3
    }
  ]
}
