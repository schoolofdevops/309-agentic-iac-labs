{
  "$schema": "https://calm.finos.org/release/1.2/meta/calm.json",
  "$id": "https://schoolofdevops.example/agentic-iac/queue-feature.calm.json",
  "title": "Production AI Workload Platform - asynchronous queue path",
  "description": "Design-time view of the API, queue, worker, result store, and secret manager.",
  "metadata": {
    "owner": "platform-engineering",
    "version": "0.1.0",
    "status": "design-review",
    "controls-evidence-boundary": "These controls are design requirements for review. Their presence is not proof of runtime enforcement.",
    "trust-boundaries": [
      "public-api",
      "workload-platform",
      "secret-management"
    ]
  },
  "nodes": [
    {
      "unique-id": "workload-api",
      "node-type": "service",
      "name": "Workload API",
      "description": "Accepts jobs and exposes job status and results.",
      "metadata": {
        "lifecycle-owner": "application",
        "trust-boundary": "public-api"
      },
      "interfaces": [
        {
          "unique-id": "jobs-api",
          "protocol": "HTTPS",
          "host": "api.workload.example",
          "port": 443,
          "path": "/v1/jobs"
        }
      ]
    },
    {
      "unique-id": "job-queue",
      "node-type": "message-queue",
      "name": "Job Queue",
      "description": "Buffers accepted jobs until a worker can process them.",
      "metadata": {
        "lifecycle-owner": "terraform",
        "trust-boundary": "workload-platform"
      },
      "interfaces": [
        {
          "unique-id": "queue-publish",
          "protocol": "AMQP",
          "host": "queue.workload.example",
          "port": 5671,
          "queue": "workload-jobs"
        },
        {
          "unique-id": "queue-consume",
          "protocol": "AMQP",
          "host": "queue.workload.example",
          "port": 5671,
          "queue": "workload-jobs"
        }
      ]
    },
    {
      "unique-id": "workload-worker",
      "node-type": "service",
      "name": "Workload Worker",
      "description": "Consumes queued jobs and records their outcome.",
      "metadata": {
        "lifecycle-owner": "application",
        "trust-boundary": "workload-platform"
      }
    },
    {
      "unique-id": "result-store",
      "node-type": "database",
      "name": "Result Store",
      "description": "Stores runtime job status and result data outside Terraform state.",
      "metadata": {
        "lifecycle-owner": "application",
        "trust-boundary": "workload-platform"
      }
    },
    {
      "unique-id": "secret-manager",
      "node-type": "system",
      "name": "Secret Manager",
      "description": "Supplies queue credentials to workloads at runtime.",
      "metadata": {
        "lifecycle-owner": "secret-management",
        "trust-boundary": "secret-management"
      }
    }
  ],
  "relationships": [
    {
      "unique-id": "api-publishes-job",
      "relationship-type": {
        "connects": {
          "source": { "node": "workload-api" },
          "destination": {
            "node": "job-queue",
            "interfaces": ["queue-publish"]
          }
        }
      },
      "protocol": "AMQP",
      "description": "The API publishes accepted job messages through the queue's encrypted publisher interface."
    },
    {
      "unique-id": "worker-consumes-job",
      "relationship-type": {
        "connects": {
          "source": {
            "node": "job-queue",
            "interfaces": ["queue-consume"]
          },
          "destination": { "node": "workload-worker" }
        }
      },
      "protocol": "AMQP",
      "description": "The worker consumes job messages through the queue's encrypted consumer interface."
    },
    {
      "unique-id": "worker-writes-result",
      "relationship-type": {
        "connects": {
          "source": { "node": "workload-worker" },
          "destination": { "node": "result-store" }
        }
      },
      "protocol": "TCP",
      "description": "The worker records job status and result data."
    },
    {
      "unique-id": "worker-reads-secret",
      "relationship-type": {
        "connects": {
          "source": { "node": "workload-worker" },
          "destination": { "node": "secret-manager" }
        }
      },
      "protocol": "HTTPS",
      "description": "The worker reads queue credentials at runtime."
    }
  ],
  "controls": {
    "secure-queue-data-flow": {
      "description": "Design requirement: protect API and queue traffic in transit and authenticate every producer and consumer.",
      "requirements": [
        {
          "requirement-url": "https://calm.finos.org/getting-started/controls/permitted-connection.requirement.json",
          "config": {
            "control-id": "security-002",
            "name": "Permitted Connection",
            "description": "Permits a connection on a relationship specified in the architecture",
            "reason": "The queue connection is approved only when AMQP is protected by TLS and each workload has its own identity.",
            "protocol": "AMQP"
          }
        }
      ]
    },
    "operable-job-queue": {
      "description": "Design requirement: make queue delay, failures, and recovery visible to operators.",
      "requirements": [
        {
          "requirement-url": "https://calm.finos.org/draft/2025-03/samples/traderx/control-requirement/monitoring_and_observability/monitoring-control-requirement.json",
          "config": {
            "control-id": "operations-queue-001",
            "name": "Job Queue Monitoring",
            "description": "Collect queue health and failure signals so operators can detect delay and recover failed work.",
            "monitoring-systems": ["OpenTelemetry"],
            "metrics-collected": ["Error Rates", "Custom Business Metrics"],
            "log-monitoring-enabled": true,
            "reporting-frequency": {
              "unit": "minutes",
              "value": 5
            },
            "historical-data-retention": {
              "unit": "months",
              "value": 3
            }
          }
        }
      ]
    }
  },
  "adrs": [
    "../decisions/0001-queue-ownership.md"
  ]
}
